# ── AI 제목 중재 (Anthropic Claude) ─────────────────────────────
# 없으면 모든 제출이 '담당자 검수 대기(review)'로 안전 보류됩니다.
ANTHROPIC_API_KEY=
# 중재 모델 (기본: 빠르고 저렴한 Haiku). 더 엄격히 가려면 claude-opus-4-8 로 교체.
MODERATION_MODEL=claude-haiku-4-5-20251001

# ── 저장소 (Supabase) ──────────────────────────────────────────
# 둘 다 없으면 로컬 data/reports.json 파일에 저장(로컬 데모 전용).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── 본문 봉인(at-rest 암호화) ──────────────────────────────────
# 32바이트 키(hex 64자 또는 base64). 생성: openssl rand -hex 32
# 없으면 본문이 평문으로 저장됩니다(운영 환경에서는 반드시 설정 권장).
REPORT_ENCRYPTION_KEY=

# ── 슈퍼 어드민(담당자) 인증 ───────────────────────────────────
# /api/admin 접근용 Bearer 토큰 = 슈퍼 어드민 암호.
# 반드시 20자 이상이어야 하며, 미설정·20자 미만이면 관리 기능이 비활성화됩니다.
# 생성 예: openssl rand -base64 32
ADMIN_TOKEN=
